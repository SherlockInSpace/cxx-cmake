# cxx-cmake house style (clang-tidy; target clang-tidy 22).
#
# Purpose: a curated diagnostic set plus the camelCase naming rules from
# docs/DECISIONS.md ("Naming"), so the house style is enforced by a tool rather than
# described in a document and is inherited by forks unchanged.
#
# Formatting (layout, whitespace, brace placement) is clang-format's job — see
# .clang-format. This file only covers diagnostics and identifier naming.
#
# Vendored files are exempt and keep upstream style, per THIRD_PARTY_NOTICES.md.
# Today that is inc/thread_pool.hpp: HeaderFilterRegex below is a positive
# match on first-party headers only, so vendored headers never produce
# diagnostics. When the first-party headers move to inc/util/ (later roadmap
# item), update HeaderFilterRegex to match the new location.
#
# These rules describe the target style; they have not yet been applied to the
# code. Renames needed to satisfy them are a separate issue.
---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-c-arrays,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length
# Disabled checks, one reason each:
#   cppcoreguidelines-avoid-magic-numbers / readability-magic-numbers:
#     alias of each other; bit-twiddling and sizing constants in small library
#     code are clearer inline than behind a name for every literal.
#   cppcoreguidelines-pro-bounds-pointer-arithmetic:
#     fires on every indexed buffer walk (hash digests, byte views); the
#     std::span alternative is a later refactor, not a lint fix.
#   cppcoreguidelines-owning-memory:
#     requires gsl::owner<> annotations; GSL is not a dependency.
#   cppcoreguidelines-avoid-c-arrays / modernize-avoid-c-arrays:
#     alias of each other (both names must be listed or the check stays on);
#     flags fixed-size digest/scratch buffers that interoperate with C APIs
#     (OpenSSL) where std::array adds nothing but noise.
#   modernize-use-trailing-return-type:
#     would force `auto f() -> T` on every function; a style choice the house style never made and
#     .clang-format do not make, so it is not imposed here.
#   readability-identifier-length:
#     `x`, `y`, `i` are the right names for operands and indices in small
#     bit-twiddling helpers; a minimum length is not part of the house style.

# Enabled by the CI job later (pass -warnings-as-errors='*' there, or
# uncomment once the rename issue has landed and the tree is clean).
# WarningsAsErrors: '*'

# Only first-party headers are analysed. Vendored inc/thread_pool.hpp is
# deliberately not matched. Update to inc/util/(bit|bloom)\.hpp when the
# headers move.
HeaderFilterRegex: 'inc/(bit|bloom)\.hpp$'

FormatStyle: file

CheckOptions:
  # --- Naming (camelCase house style) --------------------------------------
  # Types
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  # Functions
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.MethodCase
    value: camelBack
  # Variables and parameters
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack
  # Data members: trailing underscore for non-public, none for public
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PublicMemberCase
    value: camelBack
  # Static non-const data members follow the variable rule
  - key: readability-identifier-naming.ClassMemberCase
    value: camelBack
  # Constants: kCamelCase
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  # Non-constexpr `static const` class members would otherwise fall through
  # to VariableCase (camelBack); keep them kCamelCase with the other constants
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  # Namespaces
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  # Enumerators: kCamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  # Macros
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
