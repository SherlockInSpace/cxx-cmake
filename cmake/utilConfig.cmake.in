@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A static library carries its private dependencies onto the consumer's link
# line, so the consumer has to find them as well. The shared library resolves
# them itself and needs nothing here.
if(NOT @BUILD_SHARED_LIBS@)
  find_dependency(OpenSSL COMPONENTS Crypto)
endif()

# A dependency that appears in a public header or in the exported link
# interface is found unconditionally, with the same minimum version the
# library's own CMakeLists.txt asks for. For example:
#   find_dependency(fmt 10)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components("@PROJECT_NAME@")
